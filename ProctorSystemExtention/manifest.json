{
  "manifest_version": 3,
  "name": "Proctor System",
  "version": "1.0.0",
  "description": "Hệ thống giám sát thi cử với phát hiện rời tab, chặn phím tắt, và ghi nhận vi phạm.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "windows",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Hệ Thống Giám Sát Thi"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/core/logger.js",
        "src/features/block-actions.js",
        "src/features/tab-switch-detector.js",
        "src/features/fullscreen-monitor.js",
        "src/features/devtools-detector.js",
        "src/features/heartbeat.js",
        "src/features/camera-monitor.js",
        "src/content.js",
        "src/services/AI/model.json",
        "src/services/AI/group1-shard1of3.bin",
        "src/services/AI/group1-shard2of3.bin",
        "src/services/AI/group1-shard3of3.bin",
        "src/lib/tf-core.min.js",
        "src/lib/tf-converter.min.js",
        "src/lib/tf-backend-cpu.min.js"
      ],
      "matches": ["<all_urls>"]
    },
    {
      "resources": [
        "src/offscreen/offscreen.html",
        "src/offscreen/offscreen.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}