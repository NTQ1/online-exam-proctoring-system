{
  "manifest_version": 3,
  "name": "Proctor System",
  "version": "1.0.0",
  "description": "Hệ thống giám sát thi cử với phát hiện rời tab, chặn phím tắt, và ghi nhận vi phạm.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "windows",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Hệ Thống Giám Sát Thi"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/core/logger.js",
        "src/features/block-actions.js",
        "src/features/tab-switch-detector.js",
        "src/features/fullscreen-monitor.js",
        "src/features/devtools-detector.js",
        "src/features/heartbeat.js",
        "src/content.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}