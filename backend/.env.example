# ──────────────────────────────────────
# Database (MySQL)
# ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=proctor_db
DB_USER=root
DB_PASS=

# ──────────────────────────────────────
# JWT
# ──────────────────────────────────────
JWT_SECRET=your_jwt_secret

# ──────────────────────────────────────
# Server
# ──────────────────────────────────────
PORT=5001

# ──────────────────────────────────────
# Blockchain (Sepolia Testnet)
# ──────────────────────────────────────
# RPC endpoint — dùng Infura, Alchemy, hoặc public RPC
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Private key của wallet dùng để deploy & gọi contract
# ⚠️ KHÔNG commit file .env chứa private key thật!
SEPOLIA_PRIVATE_KEY=your_wallet_private_key

# Địa chỉ contract sau khi deploy bằng Hardhat Ignition
CONTRACT_ADDRESS=deployed_contract_address
